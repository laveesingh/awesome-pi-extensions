{
  "name": "pi-viewport-mouse",
  "version": "0.1.1",
  "description": "Mouse click routing for the Pi coding agent. Resolves clicks to the transcript components under them and publishes them as events other extensions can subscribe to. Requires Pi's fullscreen TUI mode, which is not the default.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./client": "./client.ts"
  },
  "files": [
    "index.ts",
    "client.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "pi-tui",
    "coding-agent",
    "tui",
    "mouse",
    "click",
    "hit-test",
    "events",
    "viewport"
  ],
  "author": "laveesingh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laveesingh/awesome-pi-extensions.git",
    "directory": "packages/viewport-mouse"
  },
  "bugs": {
    "url": "https://github.com/laveesingh/awesome-pi-extensions/issues"
  },
  "homepage": "https://github.com/laveesingh/awesome-pi-extensions/tree/main/packages/viewport-mouse#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
