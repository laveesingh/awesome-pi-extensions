{
  "name": "pi-recap",
  "version": "0.1.0",
  "description": "Ephemeral last-run recaps for the Pi coding agent TUI: a 3-bullet summary generated after each run by a configurable chat model, shown in a widget and never added to context.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run test"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "recap",
    "summary",
    "tui"
  ],
  "author": "laveesingh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laveesingh/awesome-pi-extensions.git",
    "directory": "packages/recap"
  },
  "bugs": {
    "url": "https://github.com/laveesingh/awesome-pi-extensions/issues"
  },
  "homepage": "https://github.com/laveesingh/awesome-pi-extensions/tree/main/packages/recap#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
